// --- GMCMap + ThingSpeak (V2.5.1) -------------------------------------------
//
// GMCMap (gmcmap.com / GQ Electronics) — radiation community map. HTTP-only
// (no TLS). Needs the account ID + geiger-counter ID from your gmcmap.com
// account. Radiation-only (skipped when the tube is disabled).
//
// ThingSpeak — generic time-series. Needs the channel WRITE API key. HTTPS
// supported. field1=CPM, field2=µSv/h, field3/4=CPM (current; no rolling
// windows), +field5/6/7=temp/humidity/pressure when a BME-class sensor is fit.

X_BOOL(send_gmc,               "send_gmc",   false)
X_STR (gmc_account_id,     CFG_USER_NAME_MAX + 1,  "gmc_aid",    "")
X_STR (gmc_geiger_id,      CFG_USER_NAME_MAX + 1,  "gmc_gid",    "")

X_BOOL(send_thingspeak,        "send_ts",    false)
X_BOOL(thingspeak_https,       "ts_https",   true)
X_STR (thingspeak_api_key, CFG_TOKEN_MAX     + 1,  "ts_key",     "")

// ThingSpeak (Particulate Matter) — a SECOND, independent ThingSpeak channel
// for the SPS30 dust node. Separate write key so radiation and PM live in
// their own channels. NOT tube-gated (the dust node runs with the tube off);
// skipped at runtime when no PM reading is present. field1..4 = PM1.0/PM2.5/
// PM4.0/PM10 (µg/m³), field5/6/7 = temp/humidity/pressure, field8 = typical
// particle size (µm). V2.5.4.
X_BOOL(send_thingspeak_pm,        "send_ts_pm",  false)
X_BOOL(thingspeak_pm_https,       "ts_pm_https", true)
X_STR (thingspeak_pm_api_key, CFG_TOKEN_MAX  + 1,  "ts_pm_key",   "")

