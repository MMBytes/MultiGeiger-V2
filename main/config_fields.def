// --- Display brightness -----------------------------------------------------
//
// X_U8 generic dispatch accepts any value in [min, max]. The current
// behaviour ALSO restricts to 0 OR (10..100 step 10). That step check
// stays as a hand-written special case in http_server.c::config_post,
// applied BEFORE the generic dispatch sees the field. The (0, 100)
// bounds here are the loose envelope; the step constraint is the
// tightening on top.

X_U8  (oled_brightness_pct,    "oled_bright", 80,      0,       100)

// --- Display layout mode (V2.4.9) -------------------------------------------
//
// Runtime selector for the page layout shown on the panel:
//   0 = auto      Pick at boot based on sensor presence. If any env / PM /
//                 noise / lux sensor is detected → 5-page rotation. Otherwise
//                 → Heltec-style radiation single page. Replaces the compile-
//                 time HAL_MULTIPAGE_ROTATION macro that used to be hardcoded
//                 per board in hal.h.
//   1 = radiation Single page (time + nSv/h + big CPM + status line). Always
//                 active regardless of sensors. The classic Heltec layout.
//   2 = rotation  5-page rotation (Env / PM Mass / PM Number / Uploads /
//                 System). Always active regardless of sensors. Pages with
//                 no underlying sensor are still skipped at render time.
//
// Default 0 = auto: behaves like the old hardcoded HAL_MULTIPAGE_ROTATION on
// the prod sensor stacks (FeatherS3-D with env+PM+noise = rotation; bare
// Heltec / QT Py with no sensors = radiation) without anyone having to think
// about it. Override only if you disagree with the auto-pick.
//
// Reboot-required — display task lifecycle decision happens at display_setup().

X_U32 (display_mode,           "disp_mode",   0,        0,       2)

// --- I²C bus routing (V2.5.19, QT Py ESP32-PICO only) -----------------------
//
// false (default) = primary I²C master bus on the onboard route (QT Py: STEMMA
// QT connector, IO22/IO19). true = bring it up on the broken-out SDA/SCL
// castellated pads instead (QT Py: IO4/IO33, see PIN_I2C_*_ALT in hal.h). Only
// consumed where HAL_HAS_I2C_PINOUT_SWITCH==1; forced false on every other board
// by the POST handler, so the stored value is inert elsewhere. Reboot-required —
// the bus is created once at first sensor probe.

X_BOOL(i2c_pinout,             "i2c_pinout",  false)

// --- MQTT broker client (V2.4.2 Phase 1) ------------------------------------
//
// Generic MQTT 3.1.1 publish-only client. State is published as a single JSON
// object on `<prefix>/<chip>/state` once per TX cycle; an availability topic
// `<prefix>/<chip>/availability` is retained with LWT for online/offline.
// HA Discovery payloads land in V2.4.3 (Phase 2) gated by mqtt_ha_discovery.
//
// Disabled by default — empty broker also disables (defensive; init returns
// early so no socket / DNS attempt happens until the user fills it in).

X_BOOL(mqtt_enable,            "mqtt_en",     false)
X_STR (mqtt_broker,        CFG_MQTT_HOST_MAX + 1,  "mqtt_brk",   "")
X_U32 (mqtt_port,              "mqtt_port",   1883,     1,       65535)
X_STR (mqtt_user,          CFG_USER_NAME_MAX + 1,  "mqtt_user",  "")
X_STR (mqtt_password,      CFG_PASSWORD_MAX  + 1,  "mqtt_pw",    "")
X_STR (mqtt_topic_prefix,  CFG_MQTT_PFX_MAX  + 1,  "mqtt_pfx",   "geiger")
X_BOOL(mqtt_ha_discovery,      "mqtt_ha",     true)

// --- MQTT TLS (V2.4.6) ------------------------------------------------------
//
// mqtt_tls_enable:  master switch. When on, broker URI flips to mqtts://
//                   (default port stays 1883 unless user also bumps to 8883).
// mqtt_tls_mode:    0 = A  Mozilla CA bundle (esp_crt_bundle_attach, reuses
//                          the same bundle already enabled for HTTPS uploads)
//                   1 = B  custom CA cert pasted into mqtt_tls_ca (PEM,
//                          stored in NVS, used to verify broker chain)
//                   2 = D  skip server verification entirely — TLS encryption
//                          on the wire but anyone-on-LAN MITM-able. Convenient
//                          for sealed-LAN home setups; do NOT use facing the
//                          open internet.
//                   (Mode C, fingerprint pin, was scoped out — adds custom
//                   mbedtls verify-callback wiring for marginal value on a
//                   LAN where rotating the cert means re-pasting anyway.)
// mqtt_tls_ca:      PEM-encoded CA cert. Used only when mqtt_tls_mode == 1.

X_BOOL(mqtt_tls_enable,        "mqtt_tls",    false)
X_U32 (mqtt_tls_mode,          "mqtt_tls_m",  0,        0,       2)
X_STR (mqtt_tls_ca,        CFG_MQTT_CA_CERT_MAX + 1, "mqtt_tls_ca", "")

// --- Syslog (V2.4.15) -------------------------------------------------------
//
// UDP syslog client (RFC 5424 framing) — ships every ESP_LOG line emitted
// after the syslog client comes up (post-GOT_IP) to a LAN syslog server.
// Pairs with rsyslog on the Pi broker host or any other syslog receiver.
//
// Plaintext UDP — for trusted-LAN use only. ~0 KB persistent heap (a single
// fire-and-forget sendto per line); the structural cheapest log-shipping
// path. Useful as an FTPS alternative on Heltec V2 where FTPS heap pressure
// is tightest, or as a complement when real-time visibility matters.
//
// syslog_enable:  master switch. Off by default — opt-in.
// syslog_host:    target syslog server (IPv4 or FQDN). Empty also disables.
// syslog_port:    UDP port. 514 is the standard.

X_BOOL(syslog_enable,          "syslog_en",   false)
X_STR (syslog_host,        CFG_SYSLOG_HOST_MAX + 1,  "syslog_h",   "")
X_U32 (syslog_port,            "syslog_p",    514,      1,       65535)

// --- Heap-guard auto-reboot (V2.5.14 — unattended-node fragmentation safety) -
//
// INTERNAL-DRAM fragmentation (free heap flat, but the largest contiguous
// block slowly shrinking across days of TLS handshake churn) is the OTA-stall
// precursor and a long-tail OOM risk on month+ uptimes. The 24h PSA refresh in
// periodic.c slows but does NOT fully prevent it — esp32-5965048 soak showed
// INTERNAL largest 71.7K -> 62.5K over 4.8 days despite the refresh. When > 0,
// transmission.c::tx_heap_guard() reboots the node once INTERNAL largest-free
// stays below this floor (KB) WHILE total free stays > 2x the floor (the
// fragmentation signature) for 5 consecutive TX cycles, via the clean
// main_request_restart() path. Reboot is the only certain reset of
// fragmentation. V2.5.18 moved this off the 1 Hz periodic tick onto the
// per-cycle resting heap snapshot so it no longer misfires on the transient
// largest-free dip an inbound /log fetch causes. 0 = OFF (default — opt-in per
// node). Read live each cycle, so a /config Save applies WITHOUT a reboot. ~44
// is a sane starting floor; validate
// it against an actual OTA's contiguous-alloc need before trusting in the field.
X_U32 (heap_guard_floor_kb,    "heap_guard",  0,        0,       200)

// --- PCNT pulse-width FILTER + diagnostic (V2.5.16) --------------------------
//
// When ON, the authoritative per-cycle count switches from the ISR (dead-time
// gated) count to the PCNT widest-width count (tube_pcnt.c): the hardware
// glitch filter drops count-line pulses narrower than TUBE_PCNT_WIDTHS_NS's top
// tooth (4 us), removing the 1-4 us marginal-pulse population that makes the
// Feather (ESP32-S3) read ~+14 % over the Heltec (ESP32) — see
// reference_radiation_data_analysis. This filtered count drives CPM, dose,
// /status, MQTT and all uploads.
//
// The full diagnostic is ALWAYS logged while this is on: the DIAG line (raw
// edges + spacing histogram) and the PCNT line (the 4-width comb) are emitted
// every cycle, plus a FILTER line carrying the PRE-filter counts/cpm so the
// unfiltered value stays visible. So you see both before- and after-filter.
//
// The rolling 5-/15-min averages (history.c, GMC ACPM + ThingSpeak f3/f4) are
// filtered too: history.c samples the PCNT width-filtered monotonic total when
// this is on, so cpm5/cpm15 stay consistent with the per-cycle filtered CPM.
// Off by default on every board (opt-in per node); tube must be enabled.
// Reboot-required (PCNT units are brought up at tube setup).
X_BOOL(pcnt_filter,           "pcnt_filt",   false)

// Filter width (ns): pulses narrower than this are dropped. Sets the WIDEST
// comb tooth (the filter source); the diagnostic teeth stay 0/250ns/1µs. The
// experiment found ~4µs but the optimum is temperature-sensitive (the Heltec's
// narrow-pulse fraction climbs as it warms), so it's tunable per node. Bounded
// to stay under the APB glitch-filter ceiling (~12.8µs). Reboot-required (the
// glitch filter is set at unit init). Only meaningful when pcnt_filter is on.
X_U32 (pcnt_filter_width_ns,   "pcnt_filt_w", 4000,     250,     12000)

// --- Dead-time guard / burst-collapse (V2.5.30) -----------------------------
//
// Opt-in RETRIGGERABLE refractory layered ON TOP of the fixed GMC_DEAD_TIME_US
// (190µs) ISR gate. When > 0, an edge can only start a NEW count if it follows
// a quiet gap longer than this window; edges arriving inside the window (each
// within `guard` of the PRIOR edge) extend the dead zone and are dropped — so
// an afterpulse / re-trigger TRAIN collapses to a single count regardless of how
// long the train is. The histogram-based dead-time gate (190µs) only catches the
// 50-190µs afterpulse; this reaches the 1-5ms re-trigger population that the 4µs
// PCNT width filter cannot (a width filter is 3 orders of magnitude too short in
// time). See reference_radiation_data_analysis (2026-06-14 overnight: ~60% of the
// QT Py over-count is exactly this 1-5ms burst, the other ~40% is genuine and
// unfilterable).
//
// DIAGNOSTIC / characterisation tool, NOT a production "fix": it introduces a
// board-dependent dead-time-loss term (steps the multi-year archive) and only
// removes the spurious ~60% of the gap. Keep Heltec as the dose baseline; do not
// rescale the 44205 µSv constant. Use on a NEW node with no archive, or to prove
// (with a check source) that the 1-5ms population is artifact.
//
// Enable via the `deadtime_guard` checkbox; `deadtime_guard_us` is the window
// (200-20000µs, ~3000 typical). The GMC ISR reads the window each edge, so both
// are LIVE-APPLIED on /config Save — no reboot, unlike the hardware-latched
// pcnt_filter. Tube-gated. The per-cycle count of REAL counts it suppresses —
// only edges that would have cleared the 190µs gate, i.e. its true marginal
// effect, a SUBSET of the DIAG `rejected` (don't sum the two) — is logged on the
// DIAG line as guard_removed.
//
// MUTUALLY EXCLUSIVE with pcnt_filter (ENFORCED, pcnt_filter wins): the guard
// runs in the GMC ISR, but pcnt_filter makes the separate PCNT hardware path
// authoritative for the uploaded count — which the ISR guard cannot reach. So
// enabling both would let the guard silently affect only the logged pre-filter
// value, not the real CPM (observed live: QT Py "raw CPM 90 -> filtered 97" =
// guard pulled the ISR count to 90 while 97, the PCNT value, was uploaded). The
// exclusion is enforced three ways: config_post force-clears deadtime_guard when
// pcnt_filter is set, the /config UI greys+unticks the guard box (syncGuard()),
// and config_effective_guard_us() returns 0. They target different physics anyway
// (pcnt_filter = ESP32-S3 narrow-WIDTH pulses; guard = time-domain 1-5ms
// re-triggers, e.g. the classic-ESP32 QT Py where pcnt_filter is pointless).
X_BOOL(deadtime_guard,         "dt_guard",    false)
X_U32 (deadtime_guard_us,      "dt_guard_us", 3000,     200,     20000)
