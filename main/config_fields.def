// Single-source-of-truth schema for the runtime configuration.
//
// Included multiple times by config.h / config.c / http_server.c with
// different X_* macro expansions to derive in one go:
//   * the `config_t` struct in config.h
//   * `config_defaults()` in config.c
//   * `config_load()`     NVS-read loop in config.c
//   * `config_save()`     NVS-write loop in config.c
//   * the POST pre-clear-bools loop in http_server.c
//   * the POST per-field dispatch in http_server.c
//
// Adding a field = ONE new line below. Removing or renaming = ONE edit.
// All previous duplication (struct + 3 NVS sites + 2 POST sites) is gone.
//
// Field-type macros each include must define before #include "config_fields.def":
//   X_STR(name, size, nvs_key, default)
//   X_BOOL(name, nvs_key, default)
//   X_U32(name, nvs_key, default, min, max)
//   X_F32(name, nvs_key, default, min, max)
//   X_U8(name, nvs_key, default, min, max)
//
// Any X_* an include does not care about must still be #define'd to nothing
// (the X_NOP macro at the bottom of each include block handles this).
//
// CONVENTIONS:
//   * `nvs_key` is also the HTML form field name (used by config_post). When
//     they ever need to differ, split the schema into two columns — for now
//     they are byte-identical across every field.
//   * `default` for strings is a C string literal; the truncated copy is
//     done at expansion time so users can pass anything fits in `size - 1`.
//   * `min`/`max` for numeric types are validation bounds applied by the
//     POST handler (out-of-range values are silently ignored and the field
//     keeps its prior value). Some specialised validators are still
//     hand-written in http_server.c — see the OLED_BRIGHTNESS comment.
//   * Field ORDER below is the canonical order used by the generated
//     `config_t` struct, defaults block, and NVS load/save loops. Kept to
//     match the legacy hand-written struct so this refactor is a pure
//     code-motion change with zero behaviour or NVS-key delta.
//   * Boot-time log dump (`config.c`) is intentionally NOT generated from
//     this schema — it has bespoke grouping and password masking that
//     would be ugly to derive automatically.
//   * The HTML form rendering in `http_server.c::config_get` is also NOT
//     generated — too much custom layout (headings, scripts, antenna
//     gating, brightness dropdown builder). A future revision could move
//     toward a generated form, but the cost/benefit isn't there yet.

// --- WiFi credentials + identity --------------------------------------------
//
// V2.4.1 (C3): buffer sizes use CFG_*_MAX named constants from config.h
// (real protocol/spec maxima) instead of inline magic numbers. Pre-V2.4.1
// each field was `[33]` / `[65]` etc. with the rationale only in comments.

X_STR (wifi_ssid,          CFG_WIFI_SSID_MAX + 1,  "wifi_ssid",  "")
X_STR (wifi_password,      CFG_WIFI_PSK_MAX  + 1,  "wifi_pw",    "")
X_STR (wifi_hostname,      CFG_HOSTNAME_MAX  + 1,  "wifi_host",  "")
X_STR (ap_name,            CFG_AP_NAME_MAX   + 1,  "ap_name",    "")

X_BOOL(wifi_11bg_only,         "wifi_11bg",  false)
X_BOOL(wifi_ht20_only,         "wifi_ht20",  false)
X_BOOL(wifi_ps_disabled,       "wifi_ps_dis", false)
X_BOOL(use_external_antenna,   "wifi_ext_a", false)

// --- Tube ENABLE master switch ----------------------------------------------

X_BOOL(tube_enabled,           "tube_en",    true)

// V2.5.10: the GNSS receiver is now AUTO-DETECTED at boot (gnss_init sniffs
// for live NMEA at the shared 0x10 address, binds u-blox 0x42 unambiguously),
// so the former `gnss_enable` toggle was removed — nothing to configure. The
// NVS key "gnss_en" on already-provisioned devices is simply ignored.

