# ============================================================================
# SHARED defaults — applied to every board build.
# Per-board overlays live in sdkconfig.defaults.<board>; CMake selects which
# one to chain after this file based on the BOARD variable.
# ============================================================================

# Custom partition table (factory + dual OTA, 2 MB each). Both boards use
# this layout; if a board needs different OTA slot sizes, override
# CONFIG_PARTITION_TABLE_CUSTOM_FILENAME in its overlay.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set

# Note: CONFIG_LWIP_DHCP_SET_BROADCAST_FLAG existed in IDF 5.x; removed in 6.0.
# lwIP's dhcp.c now hard-codes "no broadcast flag" (comment: "we don't need the
# broadcast flag since we can receive unicast traffic before being fully
# configured"). On our AP this is fine — spike measured 1.1 s DHCP without it.

# Keep CONFIG_LWIP_DHCP_RESTORE_LAST_IP default (y) — REBOOTING fast path on 2nd+ boot.

# DHCP debug off for overnight soak (was filling log at ~10 KB/s).
# CONFIG_LWIP_DEBUG is not set
# CONFIG_LWIP_DHCP_DEBUG is not set

# Log level: INFO by default, can bump to DEBUG via menuconfig if needed
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Wall-clock timestamp prefix on every log line (YY-MM-DD HH:MM:SS.sss).
# Pre-NTP: reads from RTC (starts at epoch 1970). Post-NTP: real Sydney local time.
# SYSTEM_FULL depends on LOG_VERSION_2 — default is V1 (ms since boot).
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM_FULL=y
# CONFIG_LOG_TIMESTAMP_SOURCE_RTOS is not set

# Bigger TCPIP task stack — we flagged 2560 as too small
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# V2.3.22: bump main task stack 8192 -> 16384. FTPS upload runs on the
# main task (called from log_ftp_loop in wifi_loop), and the TLS 1.3
# handshake + bidirectional close path is meaningfully deeper than the
# TLS 1.2 path it replaced. Diagnosed during pre1/pre2/pre3 — main task
# rebooted at FTPS time on both Heltec and FeatherS3-D before the bump.
# Original V2.0.24 history: bumped 3584 -> 8192 to fix display + reconnect
# storm overflow; that fix stays as the floor for backwards compatibility.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# TX worker blocks on TLS for seconds at a time; that legitimately starves IDLE
# on its CPU. Stop the task watchdog from monitoring both IDLE tasks — the wdt
# is still armed for every other named task (main, tx, tcpip, wifi), so a real
# hang in one of those still fires.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# Enable gratuitous ARP after GOT_IP (default is on anyway, but be explicit)
CONFIG_LWIP_ESP_GRATUITOUS_ARP=y

# Mozilla CA bundle baked into firmware flash for esp_crt_bundle_attach() (M6 HTTPS TX).
# Parent symbol is default=y in IDF 6.0; full-bundle sub-choice is the default when on.
# (IDF 5.x: CONFIG_MBEDTLS_DEFAULT_CERTIFICATE_BUNDLE_FULL → IDF 6.0: _BUNDLE_DEFAULT_FULL.)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# TLS 1.3 alongside TLS 1.2 (IDF 6.0 default is 1.2 only). mbedTLS 4.x in
# this IDF supports 1.3 production-ready; we keep 1.2 enabled as fallback for
# any server that doesn't speak 1.3 yet. 1.3 saves 1 round trip per fresh
# handshake (1-RTT vs 2-RTT) and uses ephemeral key exchange by default.
# Cost: ~30–50 KB flash; partition is at ~46 % free so plenty of headroom.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# Enable client-side TLS session ticket *protocol support* in mbedTLS. Note:
# this alone does NOT auto-cache tickets across esp_http_client_init() calls
# — that requires manual mbedtls_ssl_get_session/_set_session plumbing.
# Setting the flag costs almost nothing and unlocks the option for later.
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# Build mbedTLS with -O2 instead of -Os. Costs ~30–100 KB flash; in return
# the software ECC point multiplication (the dominant cost in our ECDHE-RSA
# handshakes — neither ESP32 nor ESP32-S3 has dedicated ECC hardware) runs
# 10–20 % faster. The FeatherS3-D's larger I-cache amortises the bigger
# code more cleanly than the Heltec's smaller cache.
CONFIG_MBEDTLS_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_MBEDTLS_COMPILER_OPTIMIZATION_SIZE is not set

# PSA crypto key-slot pool (V2.3.15). mbedTLS 4.x routes legacy crypto
# (mbedtls_aes_*, mbedtls_md_*, ECDHE key derivation, AES-GCM init) through
# PSA. Each TLS handshake allocates ~5–10 PSA slots transiently; AES-GCM
# encryption holds another ~2 per active connection. Our per-cycle load is
# 5 HTTPS targets (Madavi / SC / Radmon / OSM / aqi.eco) × ~5 slots each
# + FTPS ctrl + FTPS data ≈ 30+ active slot ops. Default 32 slots sits
# right at the edge; under transient peaks (concurrent FTPS + HTTPS, slow
# release between handshakes), exhaustion shows up as
# PSA_ERROR_INSUFFICIENT_MEMORY (-141 = -0x008D), which leaks out of
# mbedtls_ssl_setup / mbedtls_ssl_handshake as a bare error code that
# mbedtls_strerror cannot decode (PSA codes are a separate namespace).
# Bump to 128: cost ≈ +9 KB DRAM (96 extra slots × ~88 B each), gives 4×
# headroom against future feature growth (BMP581, DNMS, more upload targets).
#
# V2.4.3: the `CONFIG_MBEDTLS_PSA_KEY_SLOT_COUNT` kconfig symbol was
# REMOVED in IDF v6.0 / mbedtls 4.x (PSA config split out into
# psa/crypto_config.h). The setting still has to happen, just via a
# compile definition. See top-level CMakeLists.txt for the
# `idf_build_set_property(COMPILE_DEFINITIONS ...)` injection.

# OTA stability tweaks (lesson from V1.18.60): yield to TCPIP task during flash
# erase so the browser's upload XHR doesn't stall and drop with status 0.
CONFIG_SPI_FLASH_YIELD_DURING_ERASE=y
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# V2.3.15: bump TCP send buffer from default 5744 (4*MSS, MSS=1460) to 16384
# (~11*MSS). The default fills after ~5 KB of unacknowledged data on the
# data socket during FTPS body upload — observed exactly at 5120 bytes
# (5 × FTP_WRITE_CHUNK at the V2.3.15-pre 1024 setting). When WiFi is
# transiently slow draining ACKs at that moment, our 15 s write deadline
# fires and we abandon the upload mid-stream. The abandoned-write tear-
# down then leaks PSA crypto state in mbedTLS 4.x (mbedtls_ssl_free from a
# WANT_WRITE-then-abandon path doesn't fully release the in-flight AES-GCM
# key handle), so subsequent retries fail with PSA_ERROR_INSUFFICIENT_MEMORY
# at the data-channel handshake. A bigger send buffer ≈ lower stall
# probability ≈ fewer leaks ≈ stable uploads even on near-full 60 KB rings.
# Cost: ~10 KB extra DRAM per active TCP socket (we have one FTPS upload
# at a time, so this is bounded).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384

# Bigger sys_evt stack (default 2304). Headroom for occasional verbose driver
# logs through the applog vprintf hook (1 KB line buffer) plus deeper event
# call chains. Costs ~4 KB DRAM.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144

# mbedTLS protocol debug intentionally disabled. Saves ~30 KB flash and
# avoids the high-volume callback chain. If diagnosis ever needs it back:
# add CONFIG_MBEDTLS_DEBUG=y here, mbedtls_ssl_conf_dbg + threshold(3) in
# log_ftp.c::tls_ctx_init, and bump main task stack accordingly.
# CONFIG_MBEDTLS_DEBUG is not set

# NOTE on CONFIG_MBEDTLS_DYNAMIC_BUFFER: enabled in V2.4.5 on the Heltec
# overlays ONLY (sdkconfig.defaults.heltec_v2 + .heltec_v2_4mb). The
# FeatherS3-D and QT Py have abundant PSRAM heap so the per-record
# alloc/free CPU overhead isn't worth paying there; only the Heltec's
# tight internal-DRAM budget actually benefits.
