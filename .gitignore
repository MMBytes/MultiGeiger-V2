build/
# Per-board build dirs (build_heltec_v2, build_feathers3_d).
build_*/
sdkconfig
sdkconfig.old
# Per-board sdkconfig caches (generated by idf.py; *.defaults variants are tracked).
sdkconfig.heltec_v2
sdkconfig.heltec_v2_4mb
sdkconfig.feathers3_d
sdkconfig.adafruit_qtpy_esp32_pico
sdkconfig.*.old

# Per-release staging dir for `gh release upload` (board-suffixed binaries).
release_staging/

# IDF Component Manager: `dependencies.lock` is IGNORED (V2.5.13) — its `target:`
# field flips esp32<->esp32s3 per board across our 5-target matrix, churning the
# tree on every build. Reproducibility is preserved by pinning the EXACT esp-mqtt
# version (`==1.0.0`) in main/idf_component.yml (committed, never churns). The
# fetched component sources under `managed_components/` are regenerated on every
# clean build and must NOT be committed.
dependencies.lock
managed_components/

# VS Code workspace settings (machine-local)
.vscode/

# Local-only developer helper scripts (hardcode absolute paths)
_build.cmd
_flash.cmd
_erase_flash.cmd
_merge.cmd
_serial_log.py

# Per-release staging dirs holding board-suffixed binaries for `gh release upload`.
release_stage_*/

# Build/flash logs
*.log
