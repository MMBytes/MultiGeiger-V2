build/
# Per-board build dirs (build_heltec_v2, build_feathers3_d).
build_*/
sdkconfig
sdkconfig.old
# Per-board sdkconfig caches (generated by idf.py; *.defaults variants are tracked).
sdkconfig.heltec_v2
sdkconfig.heltec_v2_4mb
sdkconfig.feathers3_d
sdkconfig.adafruit_qtpy_esp32_pico
# V2.5.20: the XIAO cache was accidentally COMMITTED when the board was added
# (this list wasn't extended). Untracked + ignored now so all nine boards
# follow the same defaults-regenerate pattern.
sdkconfig.seeed_xiao_esp32s3
sdkconfig.heltec_wifi_lora32_v4_r2
sdkconfig.sparkfun_thing_plus_esp32s3
sdkconfig.sparkfun_thing_plus_esp32c5
sdkconfig.adafruit_esp32s3_tft_feather
sdkconfig.*.old

# Per-release staging dir for `gh release upload` (board-suffixed binaries).
release_staging/

# IDF Component Manager: `dependencies.lock` is IGNORED (V2.5.13) — its `target:`
# field flips esp32<->esp32s3 per board across our 6-target matrix, churning the
# tree on every build. Reproducibility is preserved by pinning the EXACT esp-mqtt
# version (`==1.0.0`) in main/idf_component.yml (committed, never churns). The
# fetched component sources under `managed_components/` are regenerated on every
# clean build and must NOT be committed.
dependencies.lock
managed_components/

# VS Code workspace settings (machine-local)
.vscode/

# Local-only developer helper scripts (hardcode absolute paths)
_build.cmd
_flash.cmd
_erase_flash.cmd
_merge.cmd
_serial_log.py

# Per-release staging dirs holding board-suffixed binaries for `gh release upload`.
release_stage_*/

# Build/flash logs
*.log

# Loose binaries at the repo ROOT only — local OTA images and `_merge.cmd`
# output (geiger_v2_merged_<board>.bin). All real release artefacts are built
# in CI and attached to the GitHub Release; none belong in the tree. Root-
# anchored so it never touches build_*/ outputs (already ignored) or anything
# intentional in a subdir.
/*.bin

# Local Claude Code planning/review scratch (plans, specs, MAX-review output).
# Working notes for this dev repo, not intended for the public GitHub repo.
docs/superpowers/
