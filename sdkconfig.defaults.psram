# ============================================================================
# Shared PSRAM-board defaults — consumed by feathers3_d, adafruit_qtpy_esp32_pico,
# seeed_xiao_esp32s3, heltec_wifi_lora32_v4_r2, sparkfun_thing_plus_esp32s3,
# sparkfun_thing_plus_esp32c5, adafruit_esp32s3_tft_feather, and
# adafruit_esp32_feather_v2 via CMakeLists.txt
# SDKCONFIG_DEFAULTS. Home for config that applies to every PSRAM board but has
# NO Kconfig dependency on CONFIG_SPIRAM (so it can't live in the shared
# sdkconfig.defaults, which the non-PSRAM Heltec boards also read). ONE source
# of truth — this block was previously triplicated verbatim across the three
# board overlays (V2.5.34 review finding).
# ============================================================================

# --- V2.5.34: ESP-IDF Wi-Fi roaming app -------------------------------------
# Recovers a node stuck on a weak/distant mesh BSSID after a beacon-timeout
# reconnect. Keys below: low-RSSI trigger @ -72 dBm + LEGACY roam (works without
# AP 802.11k/v); periodic-scan monitor off; 802.11v/BTM left off via its unmet
# WNM_SUPPORT dependency (setting it would trip a kconfig advisory). Full rationale
# + the reconnect-ownership handoff live in CHANGELOG.md (V2.5.34) and main.c's
# EV_DISCONNECTED comment — kept there to avoid a third drifting copy.
# EXPERIMENTAL (gated by IDF_EXPERIMENTAL_FEATURES) — bench-validate on one node.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_WIFI_ENABLE_ROAMING_APP=y
CONFIG_ESP_WIFI_ROAMING_LOW_RSSI_ROAMING=y
CONFIG_ESP_WIFI_ROAMING_LOW_RSSI_THRESHOLD=-72
CONFIG_ESP_WIFI_ROAMING_PERIODIC_SCAN_MONITOR=n
CONFIG_ESP_WIFI_ROAMING_LEGACY_ROAMING=y

# --- V2.6.18: lwIP TCP receive-mailbox depth --------------------------------
# Stock IDF default (6) queues at most 6 unread TCP segments (6*1440B MSS =
# 8640B) between the lwIP recv callback and the app's recv() call. A large
# single-connection bulk receive (OTA `/update` upload) can outrun that depth
# when the httpd task's own recv() loop is momentarily slow to drain it
# (esp_ota_write's synchronous flash-erase cycles between reads) — observed
# as a hard stall at an exact MSS-multiple byte offset (8640/11520) that
# survives all 5 x 30s retries. Reproduced repeatedly on esp32-5965048
# (feathers3_d, the fleet's heaviest node: 7 sequential TLS uploads/cycle —
# Madavi/sensor.community/ThingSpeak PM/aqi.eco/openSenseMap x2/MQTT — churns
# internal RAM harder per wall-clock minute than lighter nodes, so it hits
# the same universal RECVMBOX ceiling that other PSRAM boards haven't been
# pushed hard enough to trip yet). Scoped to PSRAM boards only: the mailbox
# entries ride the same WiFi/lwIP-to-PSRAM offload as the rest of the net
# stack (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP in sdkconfig.defaults), so the
# extra depth doesn't cost internal RAM here the way it would on the
# non-PSRAM Heltec boards.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=24
